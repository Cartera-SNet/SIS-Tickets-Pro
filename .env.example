# Copia este archivo a .env en la raíz. No pongas secretos en el repositorio.
# PostgreSQL 16 instalado en el equipo (sin Docker).

NODE_ENV=development
PORT=3000
WEB_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://sis:sis@localhost:5432/sis_tickets?schema=public

# Obligatorio en producción. Vacío en desarrollo: la sesión llega en el sprint 2.
SECRET_KEY=

# mock | real
WHATSAPP_MODE=mock
LLM_MODE=mock
ESCULAPIO_MODE=mock
GOOGLE_AUTH_MODE=mock
# dev | oidc
AUTH_MODE=dev

# Esculapio. La contraseña no se guarda: viaja como parámetro de esa API y no se registra.
ESCULAPIO_BASE_URL=https://appsintranet.esculapiosis.com/ApiCampbell/api/Usuarios/
# CA corporativa, sin desactivar la verificación TLS. Ejemplo: NODE_EXTRA_CA_CERTS=C:\certs\esculapio.pem
NODE_EXTRA_CA_CERTS=

WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=dev-webhook-secret
WHATSAPP_VERIFY_TOKEN=dev-verificar

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/google/callback

# Proveedor de IA por definir. El adaptador real habla el formato de chat completions.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

UPLOAD_DIR=./uploads
# Actas en PDF. Vacío = ./storage junto a donde corre la API.
STORAGE_DIR=
TRUSTED_PROXY=
SESSION_TTL_HOURS=8

# Solo el pipeline de staging. Vacío = no se despliega.
STAGING_HOST=
STAGING_USER=
STAGING_PATH=

# Despliegue en contenedor (Railway). Ver docs/railway.md.
# SKIP_SEED=true evita cargar los datos base cuando la base está vacía.
SKIP_SEED=
# Saltos de proxy de confianza para leer la IP real. En Railway se usa 1 sin configurar nada.
TRUST_PROXY_HOPS=
